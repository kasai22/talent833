# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Brochure emails (app/api/brochure/route.ts) — sent through https://resend.com
RESEND_API_KEY=
# Must use a domain verified in Resend.
BROCHURE_FROM="Talent833 Partners <brochures@talent833.com>"
# Optional: where brochure-request alerts go. Defaults to info@talent833.com.
BROCHURE_NOTIFY_TO=
